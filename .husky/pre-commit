#!/bin/bash

# Navigate to git repo root
cd "$(git rev-parse --show-toplevel)" || exit 1

# === Beads Integration (preserved from original hook) ===
if command -v bd &> /dev/null; then
    bd flush 2>/dev/null || true
    if [ -f ".beads/issues.jsonl" ]; then
        git diff --quiet --cached -- .beads/issues.jsonl || git add .beads/issues.jsonl
    fi
fi

# === Secret Detection ===
.husky/check-secrets.sh || exit 1

# === Merge Conflict Check ===
CONFLICT_MARKERS=$(git diff --cached --name-only | xargs grep -lE '^(<<<<<<<|=======|>>>>>>>)' 2>/dev/null || true)
if [ -n "$CONFLICT_MARKERS" ]; then
    echo "❌ BLOCKED: Merge conflict markers found in:"
    echo "$CONFLICT_MARKERS"
    exit 1
fi

# === Large File Check (>500KB) ===
LARGE_FILES=$(git diff --cached --name-only --diff-filter=d | while read f; do
    if [ -f "$f" ]; then
        SIZE=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null)
        if [ "$SIZE" -gt 512000 ]; then
            echo "$f ($((SIZE/1024))KB)"
        fi
    fi
done)
if [ -n "$LARGE_FILES" ]; then
    echo "⚠️  WARNING: Large files staged (>500KB):"
    echo "$LARGE_FILES"
    echo "Consider using Git LFS for large assets."
fi

# Move to the main project directory for lint-staged
cd ai-adventure-scribe-main || exit 1

# === Schema Drift Guard ===
# A db/schema/*.ts edit must ship with its migration in the same commit.
# Three production incidents came from that omission -- most recently
# 20260725, where combat_participant_status.exhaustion_level and eleven whole
# tables lived in schema.ts with no migration behind them, 500ing every combat
# start for months (see 17ebfd47 and docs/TESTING-REALISM.md).
#
# Only runs when db/schema/*.ts is actually staged, so it costs nothing on a
# normal commit. Offline -- no database needed. Takes a few seconds.
if git diff --cached --name-only --diff-filter=d | grep -qE '^ai-adventure-scribe-main/db/schema/.*\.ts$'; then
    echo "db/schema/*.ts changed -- checking for a matching migration..."
    set +e
    bash scripts/check-schema-drift.sh
    DRIFT_STATUS=$?
    set -e
    if [ "$DRIFT_STATUS" -ne 0 ]; then
        echo ""
        if [ "$DRIFT_STATUS" -eq 1 ]; then
            echo "Commit blocked by the schema drift guard."
            echo "Fix it properly (see the instructions above), or use --no-verify if you"
            echo "genuinely know the migration is landing separately -- but the DB Guards"
            echo "workflow will fail the push either way."
        else
            echo "Commit blocked: could not run the schema drift check."
        fi
        exit 1
    fi
fi

# === TypeScript Check (disabled - pre-existing errors, relying on CI) ===
