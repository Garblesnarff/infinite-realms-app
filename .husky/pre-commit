#!/bin/bash

# Navigate to git repo root
cd "$(git rev-parse --show-toplevel)" || exit 1

# === Beads Integration (preserved from original hook) ===
if command -v bd &> /dev/null; then
    bd flush 2>/dev/null || true
    if [ -f ".beads/issues.jsonl" ]; then
        git diff --quiet --cached -- .beads/issues.jsonl || git add .beads/issues.jsonl
    fi
fi

# === Secret Detection ===
.husky/check-secrets.sh || exit 1

# === Merge Conflict Check ===
CONFLICT_MARKERS=$(git diff --cached --name-only | xargs grep -lE '^(<<<<<<<|=======|>>>>>>>)' 2>/dev/null || true)
if [ -n "$CONFLICT_MARKERS" ]; then
    echo "❌ BLOCKED: Merge conflict markers found in:"
    echo "$CONFLICT_MARKERS"
    exit 1
fi

# === Large File Check (>500KB) ===
LARGE_FILES=$(git diff --cached --name-only --diff-filter=d | while read f; do
    if [ -f "$f" ]; then
        SIZE=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null)
        if [ "$SIZE" -gt 512000 ]; then
            echo "$f ($((SIZE/1024))KB)"
        fi
    fi
done)
if [ -n "$LARGE_FILES" ]; then
    echo "⚠️  WARNING: Large files staged (>500KB):"
    echo "$LARGE_FILES"
    echo "Consider using Git LFS for large assets."
fi

# Move to the main project directory for lint-staged
cd ai-adventure-scribe-main || exit 1

# === TypeScript Check (disabled - pre-existing errors, relying on CI) ===
# Uncomment to enable strict TypeScript checking:
# if git diff --cached --name-only | grep -qE 'ai-adventure-scribe-main/.*\.(ts|tsx)$'; then
#     echo "Running TypeScript check..."
#     bunx tsc --noEmit -p tsconfig.app.json || exit 1
# fi

# === Lint-Staged (ESLint + Prettier) ===
bunx lint-staged
