#!/bin/bash
# Pre-push guards.
#
# The pre-commit hook can be bypassed with `git commit --no-verify`, and the
# DB Guards workflow that would otherwise catch it cannot run while this
# repo's Actions allowance is exhausted. This hook is the last gate before
# code leaves the machine.
#
# See docs/TESTING-REALISM.md for the rule these enforce.

cd "$(git rev-parse --show-toplevel)" || exit 1
cd ai-adventure-scribe-main || exit 1

# Nothing to check on a branch deletion (all-zero local sha).
DELETE_ONLY=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    case "$local_sha" in
        "" | 0000000000000000000000000000000000000000) ;;
        *) DELETE_ONLY=0 ;;
    esac
done
[ "$DELETE_ONLY" -eq 1 ] && exit 0

# === Schema Drift Guard ===
# Whole-tree check, offline, ~0.5s -- cheap enough to run on every push rather
# than working out which commits touched db/schema/*.ts. Catches drift no
# matter which commit introduced it, including one committed --no-verify.
if ! bash scripts/check-schema-drift.sh; then
    echo ""
    echo "Push blocked by the schema drift guard."
    echo "db/schema/*.ts needs a migration that db/migrations/ does not provide."
    exit 1
fi

# === Migration Replay ===
# Only when migrations actually changed, and only if a PostgreSQL server is
# reachable -- most machines will not have one, and this hook is not the place
# to demand one. Skipping is fine; the DB Guards workflow replays on a pgvector
# service container once Actions minutes are available again.
if ! git diff --quiet "@{push}" HEAD -- db/migrations supabase/migrations 2>/dev/null \
   || ! git rev-parse "@{push}" >/dev/null 2>&1; then
    ADMIN_URL="${TEST_DATABASE_URL:-postgres://localhost:5432/postgres}"
    if psql -X -q "$ADMIN_URL" -c 'SELECT 1' >/dev/null 2>&1; then
        echo "Migrations changed -- replaying against $ADMIN_URL ..."
        if ! bash scripts/test-migrations.sh; then
            echo ""
            echo "Push blocked: the migration history no longer replays cleanly."
            echo "Re-run with: bun run test:migrations"
            exit 1
        fi
    else
        echo "⚠ Migrations changed but no PostgreSQL reachable at $ADMIN_URL --"
        echo "  skipping replay test. Run it with:"
        echo "    TEST_DATABASE_URL=postgres://user@host:5432/postgres bun run test:migrations"
    fi
fi

exit 0
