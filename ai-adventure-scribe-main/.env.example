# Infinite Realms environment example
# Generated from process.env/import.meta.env references on 2026-07-08.
# Copy to .env.local for frontend work and server-bun/.env for Bun server work as needed.

# Core server
NODE_ENV=development
PORT=8888
CORS_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://user:password@localhost:5432/infiniterealms
PGSSL=false
PGPOOL_MAX=10
TRUST_PROXY_HEADERS=false

# WorkOS authentication
WORKOS_API_KEY=sk_test_your_workos_api_key
WORKOS_CLIENT_ID=client_your_workos_client_id
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
ENABLE_TEST_AUTH=false
TEST_AUTH_SECRET=replace_with_test_auth_secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Legacy alias accepted by server-bun/src/lib/env.ts; prefer SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_KEY=
SUPABASE_BLOG_TABLE=blog_posts

# Frontend public config
VITE_API_URL=http://localhost:8888
VITE_TRPC_API_URL=http://localhost:8888/trpc
VITE_WS_URL=ws://localhost:8888/ws
VITE_WORKOS_CLIENT_ID=client_your_workos_client_id
VITE_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_ENVIRONMENT=development
VITE_APP_VERSION=local
VITE_RELEASE=local
VITE_GA_MEASUREMENT_ID=
VITE_OBSERVABILITY_ENABLED=false
VITE_DYNAMIC_OPTIONS=true

# Frontend feature flags
VITE_ENABLE_SAFETY_GUARDS=false
VITE_ENABLE_COMBAT_DM_NARRATION=false
# #2192: custom campaign wizard (beta users see only pre-built campaigns until the wizard produces playable content)
VITE_ENABLE_CUSTOM_CAMPAIGNS=false
VITE_USE_LOCAL_AI=false
VITE_LLM_PROVIDER=openrouter
VITE_OPENROUTER_MODEL=deepseek/deepseek-chat
VITE_DM_IMAGE_QUALITY=standard

# Development frontend helpers
VITE_DEV_TEST_EMAIL=test@example.com
VITE_DEV_TEST_PASSWORD=testpass123
VITE_CLIENT_DIST=dist
VITE_MANIFEST_PATH=dist/.vite/manifest.json

# AI providers (server-only unless explicitly VITE_ above)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
# Structured DM responses require both response_format and structured_outputs
# in OpenRouter's supported_parameters. ring-2.6-1t only advertises
# response_format and is not valid for this workload. These defaults were
# listed and schema-capable when checked on 2026-07-12.
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_FALLBACK_MODELS=nex-agi/nex-n2-mini,inclusionai/ling-2.6-1t
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_EXTRACTION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_EXTRACTION_FALLBACK_MODEL=nex-agi/nex-n2-mini
GOOGLE_GEMINI_API_KEY=your_google_gemini_key
GOOGLE_AI_API_KEY=
GOOGLE_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TEXT_FALLBACK=
GEMINI_MODEL_VARIANTS=
FAL_API_KEY=
RESEND_API_KEY=

# Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_default
STRIPE_PRO_PRICE_ID=price_pro
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise
STRIPE_CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000,https://infiniterealms.app

# Blog and marketing
SITE_URL=http://localhost:3000
SITE_NAME=Infinite Realms
SITE_DESCRIPTION=AI-powered tabletop adventures
SITE_LOGO_URL=https://infiniterealms.app/logo.png
SITE_SOCIAL_IMAGE_URL=https://infiniterealms.app/og-image.png
SITE_TWITTER=@infiniterealms
BLOG_BASE_URL=http://localhost:3000/blog
BLOG_MEDIA_BUCKET=blog-media
BLOG_SYSTEM_AUTHOR_ID=00000000-0000-0000-0000-000000000000
BLOG_SETUP_SECRET=replace_with_blog_setup_secret
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
BLOG_ADMIN_JWT_SECRET=replace_with_blog_admin_jwt_secret
BLOG_ADMIN_DEV_OVERRIDE=false
ADMIN_EMAILS=admin@example.com
ADMIN_USER_IDS=

# Screenshots and automation
SCREENSHOT_BASE_URL=http://localhost:3000
SCREENSHOT_BOT_EMAIL=bot@example.com
SCREENSHOT_BOT_PASSWORD=replace_with_bot_password

# Observability and resilience
METRICS_PUBLIC=false
METRICS_TOKEN=replace_with_metrics_token
METRICS_ALLOWLIST=127.0.0.1
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=30000

# Supabase edge-function compatibility
SECRET_NAME=
