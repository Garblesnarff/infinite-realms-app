{
  "name": "infinite-realms",
  "private": true,
  "workspaces": [
    "server-bun",
    "cli"
  ],
  "version": "0.19.5",
  "type": "module",
  "scripts": {
    "prepare": "bash ../scripts/setup-git-hooks.sh",
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "vite",
    "predev:frontend": "bash scripts/predev-frontend.sh",
    "dev:backend": "bun run bun:dev",
    "predev:backend": "bash scripts/predev-backend.sh",
    "dev:full": "bun run dev",
    "build": "vite build && node scripts/check-client-build-secrets.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit && tsc -p server-bun/tsconfig.json --noEmit",
    "type-coverage": "type-coverage -p tsconfig.app.json && type-coverage -p server-bun/tsconfig.json",
    "preview": "vite preview",
    "server:dev": "bun run bun:dev",
    "server:build": "bun -e \"console.log('server-bun uses bun runtime; no build step')\"",
    "server:start": "bun run bun:start",
    "server:start:ci": "bun run bun:start",
    "start:prod": "bun run bun:start",
    "server:test": "cd server-bun && bun run test",
    "bun:dev": "cd server-bun && bun dev",
    "bun:start": "cd server-bun && bun start",
    "bun:install": "cd server-bun && bun install",
    "test:migrations": "bash scripts/test-migrations.sh",
    "e2e": "playwright test",
    "seed:test-data": "node scripts/seed-test-data.js",
    "seed:foundry": "bun run db/seeds/foundry-example-data.ts",
    "install:all": "bun install",
    "mvp:setup": "echo 'Setting up MVP...' && bun install && echo 'Next: Copy .env.example to .env.local and configure your Supabase credentials'",
    "mvp:build": "bun run lint && bun run build",
    "check-deps": "bunx depcheck || true",
    "check-unused-exports": "bunx ts-prune --paths ./tsconfig.json || true",
    "check-case": "node scripts/check-case-duplicates.js",
    "check:db-modules": "node scripts/check-db-module-hygiene.js",
    "check:guardrails": "bun run check-case && bun run check:db-modules",
    "check-dead": "bun run check-deps && bun run check-unused-exports && bun run check-case",
    "security-lint": "node scripts/security-lint.js",
    "security:check-client-build": "node scripts/check-client-build-secrets.mjs",
    "reingest:starters": "bun tools/lore-keeper-ingest/src/index.ts reingest --repo-path ../infinite-realms-clean",
    "smoke:api": "bun run scripts/api-smoke.ts",
    "docs:serve": "bun run dev",
    "db:check-drift": "bash scripts/check-schema-drift.sh",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "5.90.20",
    "@trpc/client": "^11.7.1",
    "@trpc/react-query": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "@workos-inc/node": "^7.74.1",
    "cannon-es": "^0.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "framer-motion": "^12.23.24",
    "highlight.js": "^11.11.1",
    "howler": "^2.2.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.462.0",
    "marked": "^16.4.2",
    "openai": "^4.64.0",
    "pg": "^8.12.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "resend": "^6.5.2",
    "sanitize-html": "^2.17.0",
    "sonner": "^1.5.0",
    "stripe": "^16.6.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.160.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.11",
    "type-coverage": "^2.29.7",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^2.0.5",
    "web-vitals": "^5.1.0"
  },
  "overrides": {
    "camelcase": "^7.0.1",
    "decamelize": "^6.0.0",
    "semver": "^7.6.0",
    "ansi-styles": "^4.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
