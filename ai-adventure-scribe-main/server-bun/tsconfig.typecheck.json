{
  // Server typecheck GATE config (#2313). Extends server-bun/tsconfig.json.
  //
  // MECHANICS NOTE: tsc's `exclude` only removes files from the `include`
  // glob — it cannot suppress errors in files pulled into the program via
  // imports, and every quarantined file below is imported. Enforcement is
  // therefore file-level AND count-level, in `typecheck-known-errors.txt`
  // ("<path> : <expected error count>"), applied by
  // `../scripts/server-typecheck-gate.sh` (any error in a non-listed file
  // fails the gate; a listed file whose error count changed fails too, so a
  // new error can't hide in a quarantined file and a resolved quarantine
  // can't linger). The `exclude` entries here mirror that list as
  // documentation, each with its tracking issue.
  //
  // Quarantine rule: a file stays listed only while its tracking issue is
  // open. "Pre-existing" is not an excuse once main is green. Un-quarantine
  // by fixing the errors and deleting the entry here AND in
  // typecheck-known-errors.txt. See #2314.
  //
  // The quarantine is currently empty: #2312 (combat-intent-service.ts) and
  // #2314 (dm-response-schema.ts) were fixed, not excluded.
  "extends": "./tsconfig.json",
  "exclude": ["node_modules"]
}
