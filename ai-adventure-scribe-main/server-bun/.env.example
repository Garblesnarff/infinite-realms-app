# Server Configuration
PORT=8888
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=https://infiniterealms.app

# Client Build Directory
VITE_CLIENT_DIST=../dist

# Database Configuration
DATABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@localhost:54321/postgres
PGSSL=false
PGPOOL_MAX=10

# WorkOS Authentication (required for tRPC context)
WORKOS_API_KEY=your_workos_api_key
WORKOS_CLIENT_ID=your_workos_client_id
WORKOS_REDIRECT_URI=https://infiniterealms.app/auth/callback

# Server-only voice provider credential. Never prefix this with VITE_.
ELEVENLABS_API_KEY=

# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
