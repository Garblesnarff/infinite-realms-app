# Nginx Reverse Proxy Configuration for InfiniteRealms
#
# This configuration proxies requests to the Node.js backend running on port 8888
# and serves static frontend files with SSL/TLS encryption.
#
# Installation:
#   1. Copy this file: sudo cp nginx.conf.example /etc/nginx/sites-available/infiniterealms
#   2. Update domain name and SSL certificate paths
#   3. Enable site: sudo ln -s /etc/nginx/sites-available/infiniterealms /etc/nginx/sites-enabled/
#   4. Test config: sudo nginx -t
#   5. Reload: sudo systemctl reload nginx

# Upstream Backend Server
upstream infiniterealms_backend {
    server 127.0.0.1:8888;
    keepalive 64;
}

# HTTP to HTTPS Redirect
server {
    listen 80;
    listen [::]:80;
    server_name infiniterealms.app www.infiniterealms.app;

    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

# HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name infiniterealms.app www.infiniterealms.app;

    # SSL Certificate Configuration (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/infiniterealms.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/infiniterealms.app/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/infiniterealms.app/chain.pem;

    # SSL Security Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers live in nginx-security-headers.conf.example (#225).
    # They are included in each location below that sets its own add_header
    # (nginx drops inherited add_headers there). Copy the snippet to
    # /etc/nginx/snippets/infinite-realms-security-headers.conf and keep the
    # include paths in sync. Applying to the live host needs Rob's line.

    # Root Directory (Frontend Build)
    root /var/www/infiniterealms/ai-adventure-scribe-main/dist;
    index index.html;

    # Logging
    access_log /var/log/nginx/infiniterealms_access.log;
    error_log /var/log/nginx/infiniterealms_error.log warn;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss;

    # API Backend Proxy
    location /api/ {
        proxy_pass http://infiniterealms_backend/;
        proxy_http_version 1.1;

        # Headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering off;
        proxy_cache_bypass $http_upgrade;
    }

    # WebSocket Support (for real-time chat)
    location /ws {
        proxy_pass http://infiniterealms_backend/ws;
        proxy_http_version 1.1;

        # WebSocket Headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for WebSockets
        proxy_buffering off;

        # Increase timeouts for long-lived connections
        proxy_connect_timeout 7d;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;
    }

    # Static Assets (with caching)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        include /etc/nginx/snippets/infinite-realms-security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Frontend SPA Routes (React Router)
    # No-cache on the try_files fallback: SPA routes (e.g. /game/session/...) are served
    # index.html via this block, so it must never let a browser cache a stale entry point.
    location / {
        include /etc/nginx/snippets/infinite-realms-security-headers.conf;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires 0 always;
    }

    # index.html must NEVER be cached — it's the pointer to the current hashed JS/CSS
    # bundles. Hashed assets above are safe to cache for a year (immutable filenames);
    # index.html is the one file where the browser must always revalidate, or a stale
    # copy will reference chunk hashes a later deploy has already deleted (404s).
    # Exact match (=) takes priority over the regex asset block and over location /,
    # and try_files' internal redirect re-enters location matching — so this covers
    # both a direct hit on /index.html and the SPA fallback above.
    location = /index.html {
        include /etc/nginx/snippets/infinite-realms-security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    # Health Check Endpoint
    location /health {
        include /etc/nginx/snippets/infinite-realms-security-headers.conf;
        access_log off;
        return 200 "OK";
        add_header Content-Type text/plain;
    }
}
